// Reglas para Gestión Forestal SIN inicio de sesión.
// IMPORTANTE: el proyecto cuadrante-secona ya tiene reglas (gestor de vehículos).
// No sustituyas las existentes: copia sólo los dos bloques "match" de abajo
// dentro de "match /databases/{database}/documents { ... }" en
// Firebase Console → Firestore Database → Reglas, y pulsa Publicar.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Encargos
    match /gf_encargos/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.id == id
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 500;
    }

    // Personal adscrito
    match /gf_adscripciones/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.id == id
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 500
        && request.resource.data.job is string;
    }
  }
}
